{
	"name": "obsidian-clever-search",
	"version": "0.1.0",
	"description": "An obsidian search plugin that tunes your knowledge base to the rhythm of your fingertips.",
	"main": "main.js",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "node esbuild.config.mjs development",
		"test": "node node_modules/jest/bin/jest.js --config jest.config.js --runInBand",
		"test:coverage": "node node_modules/jest/bin/jest.js --config jest.config.js --runInBand --coverage",
		"test:hybrid-benchmark-anchor": "node node_modules/jest/bin/jest.js --config jest.hybrid-benchmark-anchor.config.js --runInBand",
		"test:hnsw-recall": "node node_modules/jest/bin/jest.js --config jest.hnsw-recall.config.js --runInBand",
		"typecheck:build": "tsc -p tsconfig.build.json -noEmit -skipLibCheck",
		"typecheck:test": "tsc -p tsconfig.test.json -noEmit -skipLibCheck",
		"build": "npm run typecheck:build && node esbuild.config.mjs production",
		"benchmark:hybrid": "node scripts/hybrid-search-benchmark.mjs",
		"benchmark:coverage-lexical": "node node_modules/jest/bin/jest.js --config jest.coverage-lexical-benchmark.config.js --runInBand",
		"benchmark:coverage-lexical:materialize-corpus": "node scripts/materialize-coverage-lexical-corpus.mjs",
		"benchmark:hybrid:real-ab": "node scripts/hybrid-real-ab-benchmark.mjs --dry-run",
		"benchmark:hybrid:context-sweep": "node scripts/hybrid-real-ab-benchmark.mjs --mode=local-budget-sweep",
		"benchmark:hybrid:regression": "node scripts/hybrid-search-benchmark.mjs --mode=regression",
		"benchmark:hybrid:tune": "node scripts/hybrid-search-benchmark.mjs --mode=tune",
		"benchmark:hybrid:tune:regression": "node scripts/hybrid-search-benchmark.mjs --mode=tune-regression",
		"optimize:lexical": "node scripts/lexical-optimizer/run.mjs --mode=mechanism --lane=mechanism-a",
		"optimize:lexical:parameter": "node scripts/lexical-optimizer/run.mjs --mode=parameter",
		"optimize:lexical:mechanism": "node scripts/lexical-optimizer/run.mjs --mode=mechanism --lane=mechanism-a",
		"release": "node release-script.mjs"
	},
	"keywords": [],
	"author": "alexclifton",
	"license": "GPL-3",
	"devDependencies": {
		"@babel/core": "^7.23.6",
		"@babel/plugin-proposal-decorators": "^7.23.6",
		"@babel/preset-env": "^7.23.6",
		"@babel/preset-typescript": "^7.23.3",
		"@codemirror/state": "^6.3.3",
		"@codemirror/view": "^6.22.3",
		"@jest/globals": "^29.7.0",
		"@tsconfig/svelte": "^3.0.0",
		"@types/dompurify": "^3.0.5",
		"@types/jest": "^29.5.11",
		"@types/node": "^16.11.6",
		"@types/throttle-debounce": "^5.0.2",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"babel-jest": "^29.7.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"esbuild-svelte": "^0.7.4",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"minisearch": "^6.3.0",
		"obsidian": "latest",
		"prettier": "^3.1.0",
		"prettier-plugin-svelte": "^3.1.2",
		"svelte": "^3.59.2",
		"svelte-preprocess": "^4.10.7",
		"tslib": "^2.4.0",
		"typescript": "^4.9.4"
	},
	"dependencies": {
		"dexie": "^3.2.4",
		"dompurify": "^3.1.7",
		"jieba-wasm": "^0.0.2",
		"reflect-metadata": "^0.1.13",
		"throttle-debounce": "^5.0.0",
		"tsyringe": "^4.8.0"
	}
}
